<style>
  .site-logo {
    display: block;
    width: 50vw;
    height: auto;
    max-height: 200px;
    margin: 0 auto;
    color: var(--color-text);

    /* 中性色走变量，彩色部分（喙、脚、西瓜）保持品牌原色 */
    --logo-body: #07181a;
    --logo-ink: #08181a;
    --logo-patch: #fff;
  }

  /* 深色背景上 tux 的黑色躯体几乎与底色同色，用一圈细描边把轮廓找回来，
     而不是反转配色——反转后就不是 tux 了。描边取正文色，与字标同重。 */
  @media (prefers-color-scheme: dark) {
    .site-logo .logo-body {
      stroke: var(--color-text);
      stroke-width: 4;
      stroke-linejoin: round;
    }
  }

  @media (max-width: 768px) {
    .site-logo {
      width: 80vw;
    }
  }
</style>
