---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteLogo from "../components/SiteLogo.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
const githubUrl = "https://github.com/npu-lug"; // TODO: Replace with your org's GitHub URL
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="home-main">
    <div class="logo-container">
      <SiteLogo />
    </div>
    <nav class="home-nav">
      <a href="/blog">博客</a>
      <a href="/about">关于</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .home-main {
    display: flex;
    flex-direction: column;
    justify-content: center; /* Vertical centering */
    align-items: center; /* Horizontal centering */
    min-height: calc(
      100vh - var(--footer-height)
    ); /* Full height minus footer */
    text-align: center;
    padding-top: 0; /* Override default main padding */
    padding-bottom: 0;
  }
  .logo-container {
    margin-bottom: var(--spacing-xxl);
  }

  .home-nav {
    display: flex;
    gap: var(--spacing-lg);
  }
  .home-nav a {
    font-size: 1.2rem;
    color: var(--color-secondary);
    text-decoration: none;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .home-nav a:hover {
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
    border-color: var(--color-primary);
  }
</style>
